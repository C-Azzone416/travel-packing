# Names only. Never commit real values; production values live in Vercel/GitHub secrets.
# App connection (pooled).
DATABASE_URL=
# Direct (non-pooled) connection, used only by `npm run db:migrate:remote`.
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_EMAIL_ALLOWLIST=

# Seeding synthetic data into a remote dev/preview database only (never the app's own). See docs/schema.md.
# SEED_DATABASE_URL=
# SEED_ALLOWED_HOSTS=
# SEED_OWNER_ID=

# Playwright only (set by playwright.config.ts). Ignored, and refused, on any Vercel deployment.
# NEVER set any of these (or NEXT_PUBLIC_E2E_BUILD) in Vercel or GitHub: a deploy check fails if they are present.
# AUTH_E2E_FAKE=
# AUTH_E2E_PASSWORD=
# E2E_DATABASE_URL=

# Destination search source (#47): "open-meteo" sends the typed query to Open-Meteo's geocoder from the
# server; anything else (or unset) uses the built-in curated list and sends nothing anywhere.
LOCATION_PROVIDER=
# Place searches allowed per minute per session (default 20; whole number 1-10000, anything else uses 20).
LOCATION_SEARCHES_PER_MINUTE=
