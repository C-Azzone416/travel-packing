# Names only. Never commit real values; production values live in Vercel/GitHub secrets.
# App connection (pooled).
DATABASE_URL=
# Direct (non-pooled) connection, used only by `npm run db:migrate:remote`.
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_EMAIL_ALLOWLIST=

# Playwright only (set by playwright.config.ts). Ignored, and refused, on any Vercel deployment.
# AUTH_E2E_FAKE=
# AUTH_E2E_PASSWORD=
